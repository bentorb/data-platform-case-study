# Optional overrides for docker-compose.yml.
# Copy to .env and edit. Every variable has a default, so .env is not required.
WAREHOUSE_DB_USER=admin
WAREHOUSE_DB_PASSWORD=postgres
WAREHOUSE_DB_NAME=warehouse

# Host port that the warehouse database is exposed on. Change it if 5432 is already in use.
WAREHOUSE_DB_PORT=5432

# Passwords for the pipeline users created by warehouse-db/init/01-create-roles.sh.
WAREHOUSE_INGESTION_PASSWORD=ingestion
WAREHOUSE_TRANSFORMATION_PASSWORD=transformation
WAREHOUSE_ANALYTICS_PASSWORD=analytics
